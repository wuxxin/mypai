# env configuration for oh-my-PI harness executing the my-pai agent
# This file is loaded by the sandbox launcher.

# ### Execution Options
# Configures the execution engine (auto, systemd, bwrap).
# Set to 'systemd' to force cgroups containment or 'bwrap' to force bubblewrap container.
# LAUNCHER_ENGINE="auto"

# ### Hardening / Feature Flags (set to true to disable)
# DISABLE_XDG_RUNTIME="false"   # Disable XDG runtime directory (Wayland, DBus, audio)
DISABLE_SSH_AUTH="true"      # Disable SSH agent forwarding
# DISABLE_WAYLAND="false"       # Disable Wayland display access
# DISABLE_AUDIO="false"         # Disable audio playback/recording
DISABLE_DBUS="true"          # Disable DBus session bus communication

# ### Namespace & Hardware Containment (set to true to isolate, false to share)
# DISABLE_HARDWARE="true"     # Isolate host GPU/DRI devices (set to true to run headless)
# DISABLE_IPC_SHARE="true"     # Isolate IPC namespace (set to false for GPU/ROCm hardware)
# DISABLE_PID_SHARE="true"     # Isolate PID namespace (set to false to share host PIDs, to enable trace or inspect of child processes)

# ### Path / Directory Mounts
# LAUNCHER_PRIVATE_BASEPATH="$HOME/agent-private"
# LAUNCHER_PRIVATE_MOUNTS=""
LAUNCHER_SANDBOX_MOUNTS="deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"
LAUNCHER_EXTRA_MOUNTS="$HOME/agent-shared:agent-shared /data/download:download"
# Set automatically from sandbox-ctl install --new-config-from
LAUNCHER_INSTALL_SOURCE="${LAUNCHER_INSTALL_SOURCE:-.}"

# ### Desktop / GUI Integration
# LAUNCHER_GUI="false"            # Set to true to enable generating a desktop entry (.desktop file)
# LAUNCHER_GUI_NAME="Oh-my-PI"
# LAUNCHER_GUI_COMMENT="Oh-my-PI agent cli"
# LAUNCHER_GUI_ICON=""
# LAUNCHER_GUI_CATEGORIES="Utility;"
# LAUNCHER_GUI_TERMINAL="false"

# ### Service & Sidecar INSTALL_CMDS needed ENV (replicated in LAUNCHER_EXPORTS)
OMP_PYTHON_VENV="$HOME/.omp/python-env"
MYPAI_PLUGIN_VENV="${LAUNCHER_INSTALL_SOURCE:-$HOME/agent-shared/code/mypai}/submodules/omp-mypai/.venv"
MYPAI_AGENT_DIR="$HOME/agent-shared/mypai-workspace"
MYPAI_AGENT_URL="http://127.0.0.1:52080"

# ### Environment Variable Exports
# List of environment variables to export into the sandbox environment
LAUNCHER_EXPORTS=(
   "LAUNCHER_INSTALL_SOURCE=$LAUNCHER_INSTALL_SOURCE"
   "OMP_PYTHON_VENV=$OMP_PYTHON_VENV"
   "UV_VENV_SYSTEM_SITE_PACKAGES=true"
   "PATH=$OMP_PYTHON_VENV/bin:$PATH"
   "MYPAI_PLUGIN_VENV=$MYPAI_PLUGIN_VENV"
   "MYPAI_AGENT_URL=$MYPAI_AGENT_URL"
   "MYPAI_AGENT_DIR=$MYPAI_AGENT_DIR"
   "SIGNAL_ACCOUNT=+15550001111"
   "SIGNAL_ALLOWED_SENDER=+15559992222"
   "HINDSIGHT_API_URL=http://localhost:8888"
   "HINDSIGHT_BANK_ID=oh-my-pi"
   "OPENAI_BASE_URL=http://localhost:51080/v1"
   "LLAMA_CPP_BASE_URL=http://localhost:51080/v1"
)

# Primary Service Execution
# Keeps systemd sandbox service unit active while persistent sidecars run
LAUNCHER_SERVICE_ENABLED="true"
LAUNCHER_SERVICE_CMD="sleep"
LAUNCHER_SERVICE_ARGS="infinity"

# Sidecar Services
LAUNCHER_SIDECARS="mypai_daemon"

LAUNCHER_SIDECAR_MYPAI_DAEMON_CMD="$MYPAI_PLUGIN_VENV/bin/python"
LAUNCHER_SIDECAR_MYPAI_DAEMON_ARGS="-m mypai_tools.daemon serve --agent-dir $MYPAI_AGENT_DIR"

LAUNCHER_SIDECAR_INPUT_SPOOLER_CMD="$MYPAI_PLUGIN_VENV/bin/python"
LAUNCHER_SIDECAR_INPUT_SPOOLER_ARGS="-m mypai_tools.input_spooler daemon --agent-dir $MYPAI_AGENT_DIR"

# Application Startup Options
# LAUNCHER_APP_FLAGS=""     # Extra flags appended to binary (e.g. '--no-sandbox' for Electron)
LAUNCHER_DEFAULT_ARGS=""
LAUNCHER_INIT_DEFAULT_PROJECT="true" # Set to true to run 'git init' on the default project workspace

# Array of bash commands executed during uninstall. Should clean up any files/directories created by LAUNCHER_INSTALL_CMDS.
LAUNCHER_UNINSTALL_CMDS=(
   'mkdir -p $HOME/.local/bin; cd $HOME/.local/bin; rm -f arbor coordinator executor openadapt review-research run-research'
   'rm -rf $OMP_PYTHON_VENV $MYPAI_PLUGIN_VENV'
)

# Array of bash commands executed during install. Must be idempotent — should recreate everything needed as if it were a fresh install.
LAUNCHER_INSTALL_CMDS=(
   "${LAUNCHER_UNINSTALL_CMDS[@]}"
   'mkdir -p $HOME/.omp/agent $HOME/.omp/plugins $MYPAI_AGENT_DIR'
   'ts=$(date +%s); for f in config.yml mcp.json models.yml; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/$f"; dst="$HOME/.omp/agent/$f"; [ -f "$dst" ] && cp "$dst" "$dst.bak.$ts"; [ -f "$src" ] && cp -f "$src" "$dst"; done'
   'for d in agents commands extensions skills; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/$d"; dst="$HOME/.omp/agent/$d"; if [ -d "$src" ]; then mkdir -p "$dst"; cp -rf "$src/." "$dst/"; fi; done'
   'if [ -d "${LAUNCHER_INSTALL_SOURCE:-.}/omp/plugins" ]; then mkdir -p "$HOME/.omp/plugins"; cp -rf "${LAUNCHER_INSTALL_SOURCE:-.}/omp/plugins/." "$HOME/.omp/plugins/"; fi'
   'omp plugin install "${LAUNCHER_INSTALL_SOURCE:-.}/submodules/omp-mypai"'
   'uv venv --system-site-packages $OMP_PYTHON_VENV'
   'export UV_VENV_SYSTEM_SITE_PACKAGES=true'
   'uv pip install --python $OMP_PYTHON_VENV/bin/python /usr/share/oh-my-pi/python/omp-rpc/dist/*.whl'
   'uv pip install --python $OMP_PYTHON_VENV/bin/python "openadapt[browser,capture]" "mcp>=1.2.0,<2" "arbor-agent[mcp]"'
   'make -C "${LAUNCHER_INSTALL_SOURCE:-.}/submodules/omp-mypai" installenv INSTALL_VENV="$MYPAI_PLUGIN_VENV"'
   '${LAUNCHER_INSTALL_SOURCE:-.}/submodules/omp-mypai/bin/membank-ctl update "$HINDSIGHT_API_URL" ${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/memorybanks --yes'
   '${LAUNCHER_INSTALL_SOURCE:-.}/submodules/omp-mypai/bin/membank-ctl update "$HINDSIGHT_API_URL" ${LAUNCHER_INSTALL_SOURCE:-.}/submodules/omp-mypai/memorybanks --yes'
)

