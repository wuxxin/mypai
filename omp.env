# env configuration for oh-my-PI harness executing the MyPAI multi-session mesh
# This file is loaded by the sandbox launcher.

# ### Execution Options
# Configures the execution engine (auto, systemd, bwrap).
# Set to 'systemd' to force cgroups containment or 'bwrap' to force bubblewrap container.
# LAUNCHER_ENGINE="auto"

# ### Hardening / Feature Flags (set to true to disable)
DISABLE_USER_PODMAN="false"     # Set to false to permit user podman in sandbox (default: true)
# DISABLE_XDG_RUNTIME="false"   # Disable XDG runtime directory (Wayland, DBus, audio)
DISABLE_SSH_AUTH="true"         # Disable SSH agent forwarding
DISABLE_WAYLAND="true"          # Disable Wayland display access
DISABLE_X11="true"              # Disable X11/Xwayland display access
# DISABLE_AUDIO="false"         # Disable audio playback/recording
DISABLE_DBUS="true"             # Disable DBus session bus communication

# ### Namespace & Hardware Containment (set to true to isolate, false to share)
# DISABLE_HARDWARE="true"       # Isolate host GPU/DRI devices (set to true to run headless)
# DISABLE_IPC_SHARE="true"      # Isolate IPC namespace (set to false for GPU/ROCm hardware)
# DISABLE_PID_SHARE="true"      # Isolate PID namespace (set to false to share host PIDs, to enable trace or inspect of child processes)

# ### Path / Directory Mounts
LAUNCHER_SANDBOX_MOUNTS="deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"
LAUNCHER_PRIVATE_MOUNTS="lifeos"
LAUNCHER_EXTRA_MOUNTS="$HOME/agent-shared:agent-shared /data/download:download $HOME/public:public"
LAUNCHER_INSTALL_SOURCE="${LAUNCHER_INSTALL_SOURCE:-.}"

# ### Service & Session Paths
HINDSIGHT_API_URL="http://localhost:28888"
OMP_PYTHON_VENV="$HOME/.omp/python-env"

LIFEOS_DIR=$HOME/.claude/LIFEOS
LIFEOS_CWD=$HOME/agent-private/lifeos
# Data home for LinkUser / ScaffoldUser / Migrate / Doctor. Without this export they
# default to ~/.config/LIFEOS and report the real mounts as broken (AGENTS.md).
LIFEOS_CONFIG_DIR=$HOME/agent-private/lifeos
LIFEOS_TOOLS_MODEL_NAME=llama.cpp/qwen3.8-flash-next
LIFEOS_TOOLS_MODEL_EFFORT=medium
# Primary Service: LifeOS Pulse (was a dummy `sleep infinity` with Pulse as sidecar).
# 2026-11-16, principal's call: the sidecar model is monitored, not supervised — killing Pulse
# left it dead twice that day (no respawn; manual relaunch). As main Exec of the installed
# omp.service unit (write_service_file → Restart=always), systemd supervises it. The transient
# `sandbox-ctl run` path keeps no restart policy: an interactive session spawning a second Pulse
# hits pulse.ts's duplicate guard and exits 1 — harmless. Revert = restore sleep/infinity here.
# Activation (host terminal, from the mypai base dir — principal's command of record):
#   ./submodules/agents-shared/scripts/sandbox-ctl install omp --new-config-from ./
LAUNCHER_SERVICE_ENABLED="true"
LAUNCHER_SERVICE_CMD="/usr/bin/bun"
LAUNCHER_SERVICE_ARGS="run --cwd $LIFEOS_DIR/PULSE pulse.ts"

# Enabled Sidecar Services: (Pulse removed — it is the Primary Service above)
LAUNCHER_SIDECARS=""

# Application Startup Options
# LAUNCHER_SERVICE_GUI="false"
LAUNCHER_DEFAULT_ARGS=""
LAUNCHER_INIT_DEFAULT_PROJECT="true"

# ### Environment Variable Exports
# Pin omp's tool shell to bash: procmgr resolveDefaultShell() prefers $SHELL (procmgr.ts:251).
LAUNCHER_EXPORTS=(
    "LAUNCHER_INSTALL_SOURCE=$LAUNCHER_INSTALL_SOURCE"
    "OPENAI_BASE_URL=http://localhost:21080/v1"
    "LLAMA_CPP_BASE_URL=http://localhost:21080/v1"
    "OMP_PYTHON_VENV=$OMP_PYTHON_VENV"
    "HINDSIGHT_API_URL=$HINDSIGHT_API_URL"
    "SHELL=/usr/bin/bash"
    "LIFEOS_DIR=$LIFEOS_DIR"
    "LIFEOS_CWD=$LIFEOS_CWD"
    "LIFEOS_CONFIG_DIR=$LIFEOS_CONFIG_DIR"
    "LIFEOS_TOOLS_MODEL_NAME=$LIFEOS_TOOLS_MODEL_NAME"
    "LIFEOS_TOOLS_MODEL_EFFORT=$LIFEOS_TOOLS_MODEL_EFFORT"
)
#    "PATH=$HOME/.local/bin:$PATH"

# Array of bash commands executed during uninstall.
LAUNCHER_UNINSTALL_CMDS=(
    'rm -f "$HOME/.local/bin/"{arbor,coordinator,executor,openadapt,review-research,run-research,membank-ctl,claude,ephemeral-omp,lifeos,ephemeral-lifeos,lifeos-workflows-tick}'
    'rm -rf $OMP_PYTHON_VENV'
)

# Array of bash commands executed during install. Must be idempotent.
LAUNCHER_INSTALL_CMDS=(
    "${LAUNCHER_UNINSTALL_CMDS[@]}"
    'mkdir -p  $HOME/.local/bin $HOME/.omp/agent'
    # omp default profile config
    'for f in config.yml mcp.json models.yml lsp.json; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/$f"; dst="$HOME/.omp/agent/$f"; if [ -f "$src" ]; then [ -f "$dst" ] && mv -f "$dst" "$dst.bak"; cp -f "$src" "$dst"; fi; done'
    'for d in agents commands extensions prompts skills rules plugins; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/$d"; dst="$HOME/.omp/agent/$d"; if [ -d "$src" ]; then mkdir -p "$dst"; cp -rf "$src/." "$dst/"; fi; done'
    # global system-prompt append = the orchestrator agent definition (relative link inside the profile dir)
    '[ -f "$HOME/.omp/agent/agents/orchestrator.md" ] && ln -sfn agents/orchestrator.md "$HOME/.omp/agent/APPEND_SYSTEM.md" || true'
    # omp default profile python venv
    'uv venv --no-managed-python --system-site-packages $OMP_PYTHON_VENV'
    'uv pip install --python $OMP_PYTHON_VENV/bin/python /usr/share/oh-my-pi/python/omp-rpc/dist/*.whl 2>/dev/null || true'
    'uv pip install --python $OMP_PYTHON_VENV/bin/python "openadapt[browser,capture]" "arbor-agent[mcp]"'
    # hindsight memory banks
    'cp -f "${LAUNCHER_INSTALL_SOURCE:-.}/bin/membank-ctl" "$HOME/.local/bin/membank-ctl" && chmod +x "$HOME/.local/bin/membank-ctl"'
    # "${LAUNCHER_INSTALL_SOURCE:-.}/bin/membank-ctl" update "$HINDSIGHT_API_URL" "${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/memorybanks" --yes
    # claude shim for LifeOS inference
    'cp -f "${LAUNCHER_INSTALL_SOURCE:-.}/bin/claude-shim.py" "$HOME/.local/bin/claude" && chmod +x "$HOME/.local/bin/claude"'
    # lifeos, ephemeral-omp, and ephemeral-lifeos scripts
    'cp -f "${LAUNCHER_INSTALL_SOURCE:-.}/bin/lifeos" "$HOME/.local/bin/lifeos" && chmod +x "$HOME/.local/bin/lifeos"'
    'cp -f "${LAUNCHER_INSTALL_SOURCE:-.}/bin/ephemeral-omp" "$HOME/.local/bin/ephemeral-omp" && chmod +x "$HOME/.local/bin/ephemeral-omp"'
    'cp -f "${LAUNCHER_INSTALL_SOURCE:-.}/bin/ephemeral-lifeos" "$HOME/.local/bin/ephemeral-lifeos" && chmod +x "$HOME/.local/bin/ephemeral-lifeos"'
    'cp -f "${LAUNCHER_INSTALL_SOURCE:-.}/bin/lifeos-workflows-tick.ts" "$HOME/.local/bin/lifeos-workflows-tick" && chmod +x "$HOME/.local/bin/lifeos-workflows-tick"'
    # LifeOS runtime deps: <configRoot>/package.json (deployed by DeployCore.ts) is the shared
    # dependency root for hooks/ and LIFEOS/ — node_modules there was lost once (2026-11-20: Vigil's
    # running adapter blind with "Cannot find package 'yaml'"), so re-install it on every apply.
    'cd "$HOME/.claude" && bun install'
)

