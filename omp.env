# env configuration for oh-my-PI harness executing the MyPAI multi-session mesh
# This file is loaded by the sandbox launcher.

# ### Execution Options
# Configures the execution engine (auto, systemd, bwrap).
# Set to 'systemd' to force cgroups containment or 'bwrap' to force bubblewrap container.
# LAUNCHER_ENGINE="auto"

# ### Hardening / Feature Flags (set to true to disable)
# DISABLE_XDG_RUNTIME="false"   # Disable XDG runtime directory (Wayland, DBus, audio)
DISABLE_SSH_AUTH="true"         # Disable SSH agent forwarding
# DISABLE_WAYLAND="false"       # Disable Wayland display access
# DISABLE_AUDIO="false"         # Disable audio playback/recording
DISABLE_DBUS="true"             # Disable DBus session bus communication

# ### Namespace & Hardware Containment (set to true to isolate, false to share)
# DISABLE_HARDWARE="true"       # Isolate host GPU/DRI devices (set to true to run headless)
# DISABLE_IPC_SHARE="true"      # Isolate IPC namespace (set to false for GPU/ROCm hardware)
# DISABLE_PID_SHARE="true"      # Isolate PID namespace (set to false to share host PIDs, to enable trace or inspect of child processes)

# ### Path / Directory Mounts
LAUNCHER_SANDBOX_MOUNTS="deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"
LAUNCHER_EXTRA_MOUNTS="$HOME/agent-shared:agent-shared /data/download:download"
LAUNCHER_INSTALL_SOURCE="${LAUNCHER_INSTALL_SOURCE:-.}"

# ### Service & Session Paths
AOE_PORT="28080"
AOE_DAEMON_URL="http://localhost:$AOE_PORT"
AOE_DAEMON_TOKEN="set-to-long-random"
AMUX_RS_PORT="28824"
AMUX_API_URL="https://localhost:$AMUX_RS_PORT"
HINDSIGHT_API_URL="http://localhost:28888"
OMP_PYTHON_VENV="$HOME/.omp/python-env"
MYPAI_MAIN_DIR="$HOME/agent-shared/mypai-main"
MYPAI_CHANNEL_DIR="$HOME/agent-shared/mypai-channel"
MYPAI_CRON_DIR="$HOME/agent-shared/mypai-cron"

# Primary Service Execution: Agent of Empires (AoE) Control Plane & ACP Supervisor
LAUNCHER_SERVICE_ENABLED="true"
LAUNCHER_SERVICE_CMD="aoe"
LAUNCHER_SERVICE_ARGS="serve --port $AOE_PORT"

# Sidecar Services:
LAUNCHER_SIDECARS="amux"
# amux-server cognitive plane
LAUNCHER_SIDECAR_AMUX_CMD="amux-server"
LAUNCHER_SIDECAR_AMUX_ARGS=""
# cc-connect chat bridge
LAUNCHER_SIDECAR_CC_CONNECT_CMD="cc-connect"
LAUNCHER_SIDECAR_CC_CONNECT_ARGS="--config $HOME/.cc-connect/config.toml"

# Application Startup Options
LAUNCHER_DEFAULT_ARGS=""
LAUNCHER_INIT_DEFAULT_PROJECT="true"

# ### Environment Variable Exports
LAUNCHER_EXPORTS=(
    "LAUNCHER_INSTALL_SOURCE=$LAUNCHER_INSTALL_SOURCE"
    "AOE_PORT=$AOE_PORT"
    "AOE_DAEMON_URL=$AOE_DAEMON_URL"
    "AOE_DAEMON_TOKEN=$AOE_DAEMON_TOKEN"
    "AMUX_API_URL=$AMUX_API_URL"
    "HINDSIGHT_API_URL=$HINDSIGHT_API_URL"
    "OPENAI_BASE_URL=http://localhost:21080/v1"
    "LLAMA_CPP_BASE_URL=http://localhost:21080/v1"
    "OMP_PYTHON_VENV=$OMP_PYTHON_VENV"
    "MYPAI_PYTHON_VENV=$MYPAI_PYTHON_VENV"
    "MYPAI_MAIN_DIR=$MYPAI_MAIN_DIR"
    "MYPAI_CHANNEL_DIR=$MYPAI_CHANNEL_DIR"
    "MYPAI_CRON_DIR=$MYPAI_CRON_DIR"
    "UV_VENV_SYSTEM_SITE_PACKAGES=true"
    "PATH=$OMP_PYTHON_VENV/bin:$HOME/.local/bin:$PATH"
    "PYTHONPATH=$OMP_PYTHON_VENV/lib/python3.14/site-packages:$MYPAI_PYTHON_VENV/lib/python3.14/site-packages:$PYTHONPATH"
)

# Array of bash commands executed during uninstall.
LAUNCHER_UNINSTALL_CMDS=(
    'mkdir -p $HOME/.local/bin; cd $HOME/.local/bin; rm -f arbor coordinator executor openadapt review-research run-research membank-ctl'
    'rm -rf $OMP_PYTHON_VENV $MYPAI_PYTHON_VENV'
)

# Array of bash commands executed during install. Must be idempotent.
LAUNCHER_INSTALL_CMDS=(
    "${LAUNCHER_UNINSTALL_CMDS[@]}"
    'mkdir -p  $HOME/.local/bin $HOME/.omp/agent $HOME/.omp/profiles/mypai/agent $HOME/.amux $HOME/.config/agent-of-empires'
    # omp default and mypai profile config
    'for f in config.yml mcp.json models.yml; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/$f"; dst="$HOME/.omp/agent/$f"; [ -f "$src" ] && cp -f "$src" "$dst"; done'
    'for d in agents commands extensions skills; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/$d"; dst="$HOME/.omp/agent/$d"; if [ -d "$src" ]; then mkdir -p "$dst"; cp -rf "$src/." "$dst/"; fi; done'
    'for f in config.yml mcp.json models.yml; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/profiles/mypai/$f"; dst="$HOME/.omp/profiles/mypai/agent/$f"; [ -f "$src" ] && cp -f "$src" "$dst"; done'
    'for d in agents commands extensions skills; do src="${LAUNCHER_INSTALL_SOURCE:-.}/omp/profiles/mypai/$d"; dst="$HOME/.omp/profiles/mypai/agent/$d"; if [ -d "$src" ]; then mkdir -p "$dst"; cp -rf "$src/." "$dst/"; fi; done'
    # omp default profile python venv
    'uv venv --system-site-packages $OMP_PYTHON_VENV'
    'uv pip install --python $OMP_PYTHON_VENV/bin/python /usr/share/oh-my-pi/python/omp-rpc/dist/*.whl 2>/dev/null || true'
    'uv pip install --python $OMP_PYTHON_VENV/bin/python -e "${LAUNCHER_INSTALL_SOURCE:-.}" "openadapt[browser,capture]" "arbor-agent[mcp]"'
    # agent of empires config
    'cp -n "${LAUNCHER_INSTALL_SOURCE:-.}/aoe/config.toml" "$HOME/.config/agent-of-empires/"'
    'cp -rf "${LAUNCHER_INSTALL_SOURCE:-.}/aoe/profiles" "$HOME/.config/agent-of-empires/"'
    # amux config
    'printf "AMUX_RS_PORT=%s\nAMUX_RS_SCHEDULER=1\nAMUX_BACKEND=aoe\nAOE_DAEMON_URL=%s\nAOE_DAEMON_TOKEN=%s\n" "$AMUX_RS_PORT" "$AOE_DAEMON_URL" "$AOE_DAEMON_TOKEN" > "$HOME/.amux/server.env"'
    # hindsight memory banks
    'cp -f "${LAUNCHER_INSTALL_SOURCE:-.}/bin/membank-ctl" "$HOME/.local/bin/membank-ctl" && chmod +x "$HOME/.local/bin/membank-ctl"'
    '"${LAUNCHER_INSTALL_SOURCE:-.}/bin/membank-ctl" update "$HINDSIGHT_API_URL" "${LAUNCHER_INSTALL_SOURCE:-.}/omp/agent/memorybanks" --yes'
    '"${LAUNCHER_INSTALL_SOURCE:-.}/bin/membank-ctl" update "$HINDSIGHT_API_URL" "${LAUNCHER_INSTALL_SOURCE:-.}/omp/profiles/mypai/memorybanks" --yes'
)

