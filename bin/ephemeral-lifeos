#!/usr/bin/env bash
set -euo pipefail

# ephemeral-lifeos - Ephemeral LifeOS session without persistent history or session data

export OMP_VOICE="${OMP_VOICE:-0}"
export LIFEOS_DIR="${LIFEOS_DIR:-$HOME/.claude/LIFEOS}"
export LIFEOS_CWD="${LIFEOS_CWD:-$HOME/agent-private/lifeos}"
export LIFEOS_CONFIG_DIR="${LIFEOS_CONFIG_DIR:-$HOME/agent-private/lifeos}"

if [[ ! -d "$LIFEOS_CWD" ]]; then
    echo "Error: Mandatory LIFEOS_CWD directory not found: $LIFEOS_CWD" >&2
    exit 1
fi

prompt_file="$LIFEOS_DIR/LIFEOS_SYSTEM_PROMPT.md"
if [[ ! -f "$prompt_file" ]]; then
    echo "Error: Mandatory LifeOS system prompt not found: $prompt_file" >&2
    exit 1
fi

tmpdir=$(mktemp -d /tmp/omp-lifeos-ephemeral-XXXXXX 2>/dev/null || mktemp -d -t omp-lifeos-ephemeral-XXXXXX)

# shellcheck disable=SC2329
cleanup() {
    rm -rf "$tmpdir"
}
trap cleanup EXIT INT TERM HUP

# Symlink static configs from ~/.omp/agent into ephemeral directory if available
agent_dir="${HOME}/.omp/agent"
if [[ -d "$agent_dir" ]]; then
    for item in config.yml models.yml lsp.json mcp.json extensions skills tools commands prompts APPEND_SYSTEM.md; do
        if [[ -e "$agent_dir/$item" ]]; then
            ln -sf "$agent_dir/$item" "$tmpdir/$item"
        fi
    done
fi

export HISTFILE=/dev/null
export PI_CODING_AGENT_DIR="$tmpdir"
export OMP_EPHEMERAL="1"

exit_code=0
omp --no-session --no-title --cwd "$LIFEOS_CWD" --append-system-prompt "$prompt_file" "$@" || exit_code=$?
exit "$exit_code"
