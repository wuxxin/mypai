#!/usr/bin/env bash
set -euo pipefail

# ephemeral-lifeos - Ephemeral LifeOS session without persistent history or session data

# Voice on by default since 2026-11-20: turn-end closers speak through Pulse's local
# speech endpoint (router :21080); OMP_VOICE=0 opts out per launch.
export OMP_VOICE="${OMP_VOICE:-1}"
export LIFEOS_DIR="${LIFEOS_DIR:-$HOME/.claude/LIFEOS}"
export LIFEOS_CWD="${LIFEOS_CWD:-$HOME/agent-private/lifeos}"
export LIFEOS_CONFIG_DIR="${LIFEOS_CONFIG_DIR:-$HOME/agent-private/lifeos}"

if [[ ! -d "$LIFEOS_CWD" ]]; then
    echo "Error: Mandatory LIFEOS_CWD directory not found: $LIFEOS_CWD" >&2
    exit 1
fi

prompt_file="$LIFEOS_DIR/LIFEOS_SYSTEM_PROMPT.md"
if [[ ! -f "$prompt_file" ]]; then
    echo "Error: Mandatory LifeOS system prompt not found: $prompt_file" >&2
    exit 1
fi

tmpdir=$(mktemp -d /tmp/omp-lifeos-ephemeral-XXXXXX 2>/dev/null || mktemp -d -t omp-lifeos-ephemeral-XXXXXX)

# shellcheck disable=SC2329
cleanup() {
    rm -rf "$tmpdir"
}
trap cleanup EXIT INT TERM HUP

# Symlink static configs from ~/.omp/agent into ephemeral directory if available
agent_dir="${HOME}/.omp/agent"
if [[ -d "$agent_dir" ]]; then
    for item in config.yml models.yml lsp.json mcp.json extensions skills tools commands prompts APPEND_SYSTEM.md RULES.md rules; do
        if [[ -e "$agent_dir/$item" ]]; then
            ln -sf "$agent_dir/$item" "$tmpdir/$item"
        fi
    done
fi

export HISTFILE=/dev/null
export PI_CODING_AGENT_DIR="$tmpdir"
export OMP_EPHEMERAL="1"

exit_code=0
# --no-judge: unattended one-shot runs (Pulse jobs launch through here); keeps router slots for the main loop.
# --no-spotlight: output-shaping aux service (default endpoint is remote, cloud.stencil.so); nothing consumes shaped results in a one-shot run.
# Tool contract append concatenated via process substitution (same mechanism as bin/lifeos; no named temp file).
omp_append="${LIFEOS_OMP_APPEND_SYSTEM:-$HOME/.omp/agent/LIFEOS_OMP_APPEND_SYSTEM.md}"
if [[ -f "$omp_append" ]]; then
    omp --no-session --no-title --no-judge --no-spotlight --cwd "$LIFEOS_CWD" --append-system-prompt <(cat "$prompt_file" "$omp_append") "$@" || exit_code=$?
else
    omp --no-session --no-title --no-judge --no-spotlight --cwd "$LIFEOS_CWD" --append-system-prompt "$prompt_file" "$@" || exit_code=$?
fi
exit "$exit_code"
